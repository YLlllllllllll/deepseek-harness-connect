{
  "name": "deepseek-harness-connect-desktop",
  "version": "1.3.0",
  "private": true,
  "description": "Local DeepSeek Harness with configurable model endpoints and remote SSH workspaces",
  "author": "YLlllllllllll",
  "license": "MIT",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "ssh2": "1.17.0"
  },
  "build": {
    "appId": "io.github.ylllllllllll.harness-connect",
    "productName": "Harness Connect",
    "files": [
      "main.cjs",
      "preload.cjs",
      "setup.html",
      "setup.cjs",
      "desktop.cjs",
      "servers-preload.cjs",
      "servers.html",
      "servers.cjs",
      "ui-check.cjs"
    ],
    "extraResources": [
      {
        "from": "../connect.sh",
        "to": "connect.sh"
      },
      {
        "from": "runtime",
        "to": "runtime"
      }
    ],
    "directories": {
      "output": "../dist/macapp"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "target": [
        "zip"
      ]
    },
    "artifactName": "Harness-Connect-${version}-${arch}.${ext}"
  }
}
